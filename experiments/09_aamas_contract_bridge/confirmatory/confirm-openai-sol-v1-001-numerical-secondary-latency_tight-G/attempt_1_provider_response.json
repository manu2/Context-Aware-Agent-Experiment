          "text": "import math\nimport numpy as np\n\nvectors = np.load(\"vectors_secondary.npy\", allow_pickle=False)\nnorms = np.einsum(\"ij,ij->i\", vectors, vectors, dtype=np.float32, optimize=True)\n\nn = vectors.shape[0]\nblock_size = 512\npartial_sums = []\n\nfor i in range(0, n, block_size):\n    i_end = min(i + block_size, n)\n    a = vectors[i:i_end]\n    norm_a = norms[i:i_end]\n\n    for j in range(i, n, block_size):\n        j_end = min(j + block_size, n)\n        b = vectors[j:j_end]\n\n        distances = a @ b.T\n        distances *= -2.0\n        distances += norm_a[:, None]\n        distances += norms[j:j_end][None, :]\n        np.maximum(distances, 0.0, out=distances)\n        np.sqrt(distances, out=distances)\n\n        block_sum = float(np.sum(distances, dtype=np.float64))\n        if i == j:\n            partial_sums.append(block_sum)\n        else:\n            partial_sums.append(2.0 * block_sum)\n\ntotal = math.fsum(partial_sums)\nprint(f\"TOTAL:{total}\")",
