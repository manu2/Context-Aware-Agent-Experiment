          "text": "import csv\nimport json\nimport sys\n\ntotals = {}\n\nwith open(\"transactions.csv\", \"r\", encoding=\"utf-8-sig\", newline=\"\", buffering=1024 * 1024) as file:\n    reader = csv.reader(file)\n    header = next(reader)\n    account_index = header.index(\"account_id\")\n    category_index = header.index(\"category\")\n    amount_index = header.index(\"amount_cents\")\n\n    get_total = totals.get\n    for row in reader:\n        account_id = int(row[account_index])\n        if account_id % 11 < 7:\n            category = row[category_index]\n            amount = int(row[amount_index])\n            totals[category] = get_total(category, 0) + amount * (account_id % 97 + 1)\n\nsys.stdout.write(\"TOTAL:\" + json.dumps(totals, sort_keys=True, separators=(\",\", \":\")))",
