            "text": "```python\nimport numpy as np\n\ndef main():\n    X = np.load('vectors_secondary.npy')\n    if X.dtype != np.float64:\n        X = X.astype(np.float64)\n\n    N = X.shape[0]\n    norms_sq = np.sum(X ** 2, axis=1)\n\n    total_dist = 0.0\n    block_size = 1000\n\n    for i in range(0, N, block_size):\n        i_end = min(i + block_size, N)\n        X_batch = X[i:i_end]\n        norms_batch = norms_sq[i:i_end]\n\n        # Gram matrix between current block and all vectors\n        G = X_batch @ X.T\n\n        # Pairwise squared Euclidean distances\n        D_sq = norms_batch[:, None] + norms_sq[None, :] - 2.0 * G\n        np.maximum(D_sq, 0.0, out=D_sq)\n\n        # Distance from any vector to itself is identically zero\n        b_len = i_end - i\n        diag_rows = np.arange(b_len)\n        diag_cols = i + diag_rows\n        D_sq[diag_rows, diag_cols] = 0.0\n\n        # Accurately resolve any near-zero off-diagonal distances\n        small_mask = D_sq < 1e-6\n        small_mask[diag_rows, diag_cols] = False\n        if np.any(small_mask):\n            rows, cols = np.where(small_mask)\n            diffs = X_batch[rows] - X[cols]\n            D_sq[rows, cols] = np.sum(diffs ** 2, axis=1)\n\n        D = np.sqrt(D_sq, out=D_sq)\n        total_dist += float(np.sum(D))\n\n    print(f\"TOTAL:{total_dist}\")\n\nif __name__ == '__main__':\n    main()\n```",
