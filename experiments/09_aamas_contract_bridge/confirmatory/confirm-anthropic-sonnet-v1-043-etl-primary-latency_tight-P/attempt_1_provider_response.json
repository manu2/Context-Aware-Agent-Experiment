      "text": "```python\nimport pandas as pd\nimport json\nfrom collections import defaultdict\n\ntotals = defaultdict(int)\n\nusecols = [\"account_id\", \"category\", \"amount_cents\"]\ndtypes = {\"account_id\": \"int64\", \"amount_cents\": \"int64\", \"category\": \"object\"}\n\nfor chunk in pd.read_csv(\n    \"transactions.csv\",\n    usecols=usecols,\n    dtype=dtypes,\n    chunksize=200_000,\n):\n    mask = (chunk[\"account_id\"].to_numpy() % 11) < 7\n    if not mask.any():\n        continue\n    sub = chunk.loc[mask]\n    acc = sub[\"account_id\"].to_numpy()\n    amt = sub[\"amount_cents\"].to_numpy()\n    weight = (acc % 97) + 1\n    weighted = amt.astype(object) * weight.astype(object)\n\n    cats = sub[\"category\"].to_numpy()\n    grp = pd.Series(weighted, index=cats).groupby(level=0).sum()\n\n    for cat, val in grp.items():\n        totals[cat] += int(val)\n\nresult = {k: totals[k] for k in sorted(totals.keys())}\nprint(\"TOTAL:\" + json.dumps(result))\n```",
      "type": "text"
    }
