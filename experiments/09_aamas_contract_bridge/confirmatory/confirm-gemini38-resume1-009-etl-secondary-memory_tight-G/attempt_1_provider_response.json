            "text": "An efficient and complete Python program to accomplish this task is provided below.\n\n```python\nimport os\nimport json\nfrom collections import defaultdict\nimport pandas as pd\n\n\ndef main():\n    filepath = 'transactions_secondary.csv'\n    if not os.path.exists(filepath):\n        print(\"TOTAL:{}\")\n        return\n\n    totals = defaultdict(int)\n\n    try:\n        # Stream the CSV in chunks to minimize memory usage and maximize speed\n        reader = pd.read_csv(\n            filepath,\n            usecols=['account_id', 'category', 'amount_cents'],\n            dtype={'account_id': 'int64', 'category': 'str', 'amount_cents': 'int64'},\n            chunksize=500_000\n        )\n        \n        for chunk in reader:\n            # Filter rows whose account_id % 13 < 8\n            mask = (chunk['account_id'] % 13) < 8\n            sub = chunk[mask]\n            if sub.empty:\n                continue\n\n            multiplier = (sub['account_id'] % 89) + 3\n            \n            # Guard against potential 64-bit integer overflow on extreme values\n            if sub['amount_cents'].abs().max() < 100_000_000_000:\n                prod = sub['amount_cents'] * multiplier\n            else:\n                prod = sub['amount_cents'].astype(object) * multiplier.astype(object)\n\n            # Group by category within the chunk and accumulate to total\n            chunk_grouped = prod.groupby(sub['category']).sum()\n            for cat, val in chunk_grouped.items():\n                totals[str(cat)] += int(val)\n\n    except pd.errors.EmptyDataError:\n        pass\n\n    print(f\"TOTAL:{json.dumps(totals, sort_keys=True)}\")\n\n\nif __name__ == '__main__':\n    main()\n```",
