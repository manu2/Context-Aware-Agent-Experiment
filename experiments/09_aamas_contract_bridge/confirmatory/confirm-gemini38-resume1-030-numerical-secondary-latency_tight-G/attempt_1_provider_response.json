            "text": "An efficient and numerically stable implementation in Python that balances memory usage and execution speed:\n\n```python\nimport numpy as np\n\n\ndef main():\n    # Load input array and convert to float64 to ensure high numerical precision\n    # during dot product and norm expansions.\n    X = np.load(\"vectors_secondary.npy\").astype(np.float64)\n    n = X.shape[0]\n\n    # Precompute squared L2 norms for each vector: ||x_i||^2\n    sq_norms = np.sum(X**2, axis=1)\n\n    total_distance = 0.0\n    chunk_size = 1000\n\n    # Process in chunks to maintain a low memory footprint while utilizing BLAS GEMM\n    for start in range(0, n, chunk_size):\n        end = min(start + chunk_size, n)\n        chunk_len = end - start\n\n        # Compute dot products between chunk vectors and all vectors: X_chunk @ X^T\n        G = X[start:end] @ X.T\n\n        # ||u - v||^2 = ||u||^2 + ||v||^2 - 2 * <u, v>\n        d_sq = sq_norms[start:end, None] + sq_norms[None, :] - 2.0 * G\n\n        # Set diagonal entries strictly to zero to avoid precision noise where i == j\n        d_sq[np.arange(chunk_len), np.arange(start, end)] = 0.0\n\n        # Guard against small negative values from floating-point roundoff\n        np.maximum(d_sq, 0.0, out=d_sq)\n        np.sqrt(d_sq, out=d_sq)\n\n        total_distance += np.sum(d_sq)\n\n    print(f\"TOTAL:{total_distance}\")\n\n\nif __name__ == \"__main__\":\n    main()\n```",
