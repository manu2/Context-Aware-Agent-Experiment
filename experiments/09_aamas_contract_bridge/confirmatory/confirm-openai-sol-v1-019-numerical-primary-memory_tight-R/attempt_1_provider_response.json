          "text": "import numpy as np\n\nvectors = np.load(\"vectors.npy\", mmap_mode=\"r\")\nx = np.asarray(vectors, dtype=np.float64)\n\nn = x.shape[0]\nblock_size = 1024\nsquared_norms = np.einsum(\"ij,ij->i\", x, x, dtype=np.float64)\ntotal = np.longdouble(0)\n\nfor i in range(0, n, block_size):\n    i_end = min(i + block_size, n)\n    xi = x[i:i_end]\n    ni = squared_norms[i:i_end]\n\n    for j in range(i, n, block_size):\n        j_end = min(j + block_size, n)\n        xj = x[j:j_end]\n        nj = squared_norms[j:j_end]\n\n        distances = xi @ xj.T\n        distances *= -2.0\n        distances += ni[:, None]\n        distances += nj[None, :]\n        np.maximum(distances, 0.0, out=distances)\n\n        if i == j:\n            np.fill_diagonal(distances, 0.0)\n\n        np.sqrt(distances, out=distances)\n        block_sum = np.sum(distances, dtype=np.longdouble)\n\n        total += block_sum if i == j else 2 * block_sum\n\nprint(\"TOTAL:\" + np.format_float_positional(total, unique=True, trim=\"-\"))",
          "type": "output_text"
        }
